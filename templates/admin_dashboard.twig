{% extends '@admin/layout.twig' %}

{% block title %}{{ trans('stat.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
<link rel="stylesheet" href="{{ ext_asset('stat', 'stat.css') }}">
{% include '@admin/_page_header.twig' with {heading: trans('stat.title')} only %}

<section class="card-box stat-viz">
    <nav class="stat-range" aria-label="{{ trans('stat.title') }}">
        {% for name in ['7', '30', '90'] %}
            <a href="{{ url('/admin/stat') }}?range={{ name }}" {{ range == name ? 'aria-current="page"' }}>{{ trans('stat.range.' ~ name) }}</a>
        {% endfor %}
    </nav>

    <div class="stat-tiles">
        <div class="stat-tile"><span class="label">{{ trans('stat.metric.views') }}</span><span class="value">{{ totals.views }}</span></div>
        <div class="stat-tile"><span class="label">{{ trans('stat.metric.visitors') }}</span><span class="value">{{ totals.visitors }}</span></div>
        {% if conversion %}
            <div class="stat-tile">
                <span class="label">{{ trans('stat.section.conversion') }} – {{ trans(conversion.label_key) }}</span>
                <span class="value">{{ conversion.count }}</span>
                {% if conversion.rate is not null %}<small>{{ trans('stat.conversion.rate', {rate: (conversion.rate * 100)|number_format(1)}) }}</small>{% else %}<small>{{ trans('stat.conversion.no_visitors') }}</small>{% endif %}
            </div>
        {% endif %}
    </div>

    <div class="stat-section">
        <h2>{{ trans('stat.section.views_over_time') }}</h2>
        {% if totals.views == 0 %}
            <p class="stat-empty">{{ trans('stat.empty') }}</p>
        {% else %}
            <ul class="stat-legend">
                <li><span class="swatch" style="background: var(--stat-series-1)"></span> {{ trans('stat.metric.views') }}</li>
                <li><span class="swatch" style="background: var(--stat-series-2)"></span> {{ trans('stat.metric.visitors') }}</li>
            </ul>
            <div class="stat-chart-wrap" data-stat-chart data-series="{{ series|json_encode }}">
                <svg class="stat-chart" viewBox="0 0 {{ chart.width }} {{ chart.height }}" role="img" aria-label="{{ trans('stat.section.views_over_time') }}">
                    {% for line in chart.grid %}
                        <line class="grid" x1="{{ chart.pad_left }}" x2="{{ chart.plot_right }}" y1="{{ line.y }}" y2="{{ line.y }}"></line>
                        <text x="{{ chart.pad_left - 8 }}" y="{{ line.y + 3 }}" text-anchor="end" font-size="10" fill="var(--stat-text)">{{ line.value }}</text>
                    {% endfor %}
                    {% for label in chart.labels %}
                        <text x="{{ label.x }}" y="{{ chart.plot_bottom + 16 }}" text-anchor="middle" font-size="10" fill="var(--stat-text)">{{ label.text }}</text>
                    {% endfor %}
                    <polyline class="line line-views" points="{{ chart.points_views }}"></polyline>
                    <polyline class="line line-visitors" points="{{ chart.points_visitors }}"></polyline>
                </svg>
                <div class="stat-tooltip" data-stat-tooltip hidden></div>
            </div>
        {% endif %}
    </div>

    <div class="stat-section">
        <h2>{{ trans('stat.section.top_offers') }}</h2>
        {% if top.offers is empty %}
            <p class="stat-empty">{{ trans('stat.empty') }}</p>
        {% else %}
            <div class="stat-figure">
                {% set max = top.offers[0].views %}
                {% for row in top.offers %}
                    <div class="stat-figure-row">
                        <span class="name">{{ row.path }}</span>
                        <span class="count">{{ row.views }}</span>
                        <span class="track"><span class="stat-w-{{ max > 0 ? ((row.views / max * 100 / 5)|round) * 5 : 0 }}"></span></span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="stat-section">
        <h2>{{ trans('stat.section.top_pages') }}</h2>
        {% if top.pages is empty %}
            <p class="stat-empty">{{ trans('stat.empty') }}</p>
        {% else %}
            <div class="stat-figure">
                {% set max = top.pages[0].views %}
                {% for row in top.pages %}
                    <div class="stat-figure-row">
                        <span class="name">{{ row.path }}</span>
                        <span class="count">{{ row.views }}</span>
                        <span class="track"><span class="stat-w-{{ max > 0 ? ((row.views / max * 100 / 5)|round) * 5 : 0 }}"></span></span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="stat-section">
        <h2>{{ trans('stat.section.referrers') }}</h2>
        {% if referrers is empty %}
            <p class="stat-empty">{{ trans('stat.referrer.direct') }}</p>
        {% else %}
            <div class="stat-figure">
                {% set max = referrers[0].views %}
                {% for row in referrers %}
                    <div class="stat-figure-row">
                        <span class="name">{{ row.domain }}</span>
                        <span class="count">{{ row.views }}</span>
                        <span class="track"><span class="stat-w-{{ max > 0 ? ((row.views / max * 100 / 5)|round) * 5 : 0 }}"></span></span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="stat-section">
        <h2>{{ trans('stat.section.devices') }}</h2>
        {% set deviceTotal = devices.desktop + devices.mobile + devices.tablet %}
        {% if deviceTotal == 0 %}
            <p class="stat-empty">{{ trans('stat.empty') }}</p>
        {% else %}
            <div class="stat-devices">
                {% if devices.desktop > 0 %}<span class="stat-w-{{ ((devices.desktop / deviceTotal * 100 / 5)|round) * 5 }}">{{ (devices.desktop / deviceTotal * 100)|round }}%</span>{% endif %}
                {% if devices.mobile > 0 %}<span class="stat-w-{{ ((devices.mobile / deviceTotal * 100 / 5)|round) * 5 }}">{{ (devices.mobile / deviceTotal * 100)|round }}%</span>{% endif %}
                {% if devices.tablet > 0 %}<span class="stat-w-{{ ((devices.tablet / deviceTotal * 100 / 5)|round) * 5 }}">{{ (devices.tablet / deviceTotal * 100)|round }}%</span>{% endif %}
            </div>
            <ul class="stat-legend">
                <li><span class="swatch" style="background: var(--stat-series-1)"></span> {{ trans('stat.device.desktop') }} ({{ devices.desktop }})</li>
                <li><span class="swatch" style="background: var(--stat-series-2)"></span> {{ trans('stat.device.mobile') }} ({{ devices.mobile }})</li>
                <li><span class="swatch" style="background: var(--stat-series-3)"></span> {{ trans('stat.device.tablet') }} ({{ devices.tablet }})</li>
            </ul>
        {% endif %}
    </div>

    <div class="stat-section">
        <h2>{{ trans('stat.section.countries') }}</h2>
        {% if countries is empty %}
            <p class="stat-empty">{{ trans('stat.countries.unavailable') }}</p>
        {% else %}
            <div class="stat-figure">
                {% set max = countries[0].views %}
                {% for row in countries %}
                    <div class="stat-figure-row">
                        <span class="name">{{ row.country }}</span>
                        <span class="count">{{ row.views }}</span>
                        <span class="track"><span class="stat-w-{{ max > 0 ? ((row.views / max * 100 / 5)|round) * 5 : 0 }}"></span></span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <p class="stat-privacy-note">{{ trans('stat.privacy_note') }}</p>
</section>

<script src="{{ ext_asset('stat', 'stat-chart.js') }}" defer></script>
{% endblock %}
